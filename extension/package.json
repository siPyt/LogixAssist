{
  "name": "logix-assistant-bridge",
  "displayName": "Logix Assistant Bridge",
  "description": "Lets the Logix Assistant app use the Claude Sonnet model from your VS Code (GitHub Copilot) subscription. Runs a local-only, token-protected bridge.",
  "version": "0.2.0",
  "publisher": "logixassist",
  "author": "Charles R. Freeman",
  "license": "UNLICENSED",
  "private": true,
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": ["AI", "Other"],
  "activationEvents": ["onStartupFinished"],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      { "command": "logixAssistant.openApp", "title": "Logix Assistant: Open App (auto-pair)" },
      { "command": "logixAssistant.copyToken", "title": "Logix Assistant: Copy Pairing Token" },
      { "command": "logixAssistant.regenerateToken", "title": "Logix Assistant: Regenerate Pairing Token" },
      { "command": "logixAssistant.restart", "title": "Logix Assistant: Restart Bridge" },
      { "command": "logixAssistant.showStatus", "title": "Logix Assistant: Bridge Options" }
    ],
    "configuration": {
      "title": "Logix Assistant",
      "properties": {
        "logixAssistant.port": {
          "type": "number",
          "default": 47821,
          "description": "Local port for the bridge (127.0.0.1 only)."
        },
        "logixAssistant.model": {
          "type": "string",
          "default": "claude-sonnet-5.5",
          "description": "Preferred model family or name. Falls back to the newest Claude Sonnet, then any available model."
        },
        "logixAssistant.appUrl": {
          "type": "string",
          "default": "http://localhost:5173",
          "description": "URL opened by \"Open App (auto-pair)\". Set this to your Vercel URL to pair the deployed app."
        },
        "logixAssistant.allowedOrigins": {
          "type": "array",
          "items": { "type": "string" },
          "default": [
            "http://localhost:5173", "http://127.0.0.1:5173",
            "http://localhost:5174", "http://127.0.0.1:5174",
            "http://localhost:5175", "http://127.0.0.1:5175",
            "http://localhost:5176", "http://127.0.0.1:5176",
            "http://localhost:4173", "http://127.0.0.1:4173"
          ],
          "description": "Web app origins allowed to call the bridge. Add your Vercel URL (e.g. https://logix-assist.vercel.app)."
        }
      }
    }
  },
  "scripts": {
    "build": "tsc -p .",
    "test": "npm run build && node test/smoke.cjs",
    "package": "npm run build && npx --yes @vscode/vsce package --allow-missing-repository --skip-license"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "@types/vscode": "^1.95.0",
    "typescript": "^5.6.3"
  }
}
