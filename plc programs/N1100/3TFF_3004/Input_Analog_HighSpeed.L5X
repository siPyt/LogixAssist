<Routines Use="Context">
<Routine Use="Target" Name="Input_Analog_HighSpeed" Type="RLL">
<Description>
<![CDATA[HighSpeed Analog Input Scaling]]>
</Description>
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[HighSpeed Scaling for WI101

Map the raw analog input value from the configured analog input address.]]>
</Comment>
<Text>
<![CDATA[MOV(LI02.Address,Address);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[Map the raw analog input value from the configured analog input address.]]>
</Comment>
<Text>
<![CDATA[MOV(IND131_WI101:I.Data[0],LI02.RawValue);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Comment>
<![CDATA[Move the filtered raw value and the min and max scaling values to the scale instruction.]]>
</Comment>
<Text>
<![CDATA[[MOV(LI02.RawValue,SCL.In) ,MOV(LI02.RawMin,SCL.InRawMin) ,MOV(LI02.RawMax,SCL.InRawMax) ,MOV(LI02.ScaledMin,SCL.InEUMin) ,MOV(LI02.ScaledMax,SCL.InEUMax) ];]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Comment>
<![CDATA[Scale the raw analog input value.]]>
</Comment>
<Text>
<![CDATA[JSR(Scale,0);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Comment>
<![CDATA[Move the scaled result to the analog input current value.
If Configured for real input then copy If not input is sent in from another source.
]]>
</Comment>
<Text>
<![CDATA[XIC(LI02.RealCfg)MOV(SCL.Out,WI101_Unfiltered);]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Comment>
<![CDATA[HighSpeed Scaling for WI101

Map the raw analog input value from the configured analog input address.]]>
</Comment>
<Text>
<![CDATA[MOV(LI03.Address,Address);]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Comment>
<![CDATA[Map the raw analog input value from the configured analog input address.]]>
</Comment>
<Text>
<![CDATA[[EQU(ThisSystem.MoldType,3) MOV(MOLD_TFF:I.Data[1],LI03.RawValue) ,EQU(ThisSystem.MoldType,0) MOV(MOLD_TFF3:I.Data[1],LI03.RawValue) ];]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Comment>
<![CDATA[Move the filtered raw value and the min and max scaling values to the scale instruction.]]>
</Comment>
<Text>
<![CDATA[[MOV(LI03.RawValue,SCL.In) ,MOV(LI03.RawMin,SCL.InRawMin) ,MOV(LI03.RawMax,SCL.InRawMax) ,MOV(LI03.ScaledMin,SCL.InEUMin) ,MOV(LI03.ScaledMax,SCL.InEUMax) ];]]>
</Text>
</Rung>
<Rung Number="8" Type="N">
<Comment>
<![CDATA[Scale the raw analog input value.]]>
</Comment>
<Text>
<![CDATA[JSR(Scale,0);]]>
</Text>
</Rung>
<Rung Number="9" Type="N">
<Comment>
<![CDATA[Move the scaled result to the analog input current value.
If Configured for real input then copy If not input is sent in from another source.
]]>
</Comment>
<Text>
<![CDATA[XIC(LI03.RealCfg)MOV(SCL.Out,WI102_Unfiltered);]]>
</Text>
</Rung>
<Rung Number="10" Type="N">
<Comment>
<![CDATA[HighSpeed Scaling for WI001

Map the raw analog input value from the configured analog input address.]]>
</Comment>
<Text>
<![CDATA[MOV(LI04.Address,Address);]]>
</Text>
</Rung>
<Rung Number="11" Type="N">
<Comment>
<![CDATA[Map the raw analog input value from the configured analog input address.]]>
</Comment>
<Text>
<![CDATA[MOV(IND331_WI001:I.Data[0],LI04.RawValue);]]>
</Text>
</Rung>
<Rung Number="12" Type="N">
<Comment>
<![CDATA[Move the filtered raw value and the min and max scaling values to the scale instruction.]]>
</Comment>
<Text>
<![CDATA[[MOV(LI04.RawValue,SCL.In) ,MOV(LI04.RawMin,SCL.InRawMin) ,MOV(LI04.RawMax,SCL.InRawMax) ,MOV(LI04.ScaledMin,SCL.InEUMin) ,MOV(LI04.ScaledMax,SCL.InEUMax) ];]]>
</Text>
</Rung>
<Rung Number="13" Type="N">
<Comment>
<![CDATA[Scale the raw analog input value.]]>
</Comment>
<Text>
<![CDATA[JSR(Scale,0);]]>
</Text>
</Rung>
<Rung Number="14" Type="N">
<Comment>
<![CDATA[Move the scaled result to the analog input current value.
If Configured for real input then copy If not input is sent in from another source.
]]>
</Comment>
<Text>
<![CDATA[XIC(LI04.RealCfg)MOV(SCL.Out,WI001_Unfiltered);]]>
</Text>
</Rung>
<Rung Number="15" Type="N">
<Comment>
<![CDATA[FILTER THE SCALED ANALOG VALUES]]>
</Comment>
<Text>
<![CDATA[[XIO(TMR_SampleRate.DN) TON(TMR_SampleRate,?,?) ,XIO(TMR_MaveFlow.DN) TON(TMR_MaveFlow,?,?) ,XIO(TMR_EXPFlow.DN) TON(TMR_EXPFlow,?,?) ,JSR(Scale_Filtering,0) ,XIO(P002.RunStatus) FLL(0,FiltrateFlow_Array[0],101) ];]]>
</Text>
</Rung>
<Rung Number="16" Type="N">
<Comment>
<![CDATA[Map the analog input value to the analog alarm process variable if alarming is configured for the input.
Analog alarm array subscripts are equal to the analog input array subscripts.]]>
</Comment>
<Text>
<![CDATA[XIC(LI02Alarm.EnableCfg)MOV(LI02.CurrentValue,LI02Alarm.PV);]]>
</Text>
</Rung>
<Rung Number="17" Type="N">
<Comment>
<![CDATA[Map the analog input value to the analog alarm process variable if alarming is configured for the input.
Analog alarm array subscripts are equal to the analog input array subscripts.]]>
</Comment>
<Text>
<![CDATA[XIC(LI03Alarm.EnableCfg)MOV(LI03.CurrentValue,LI03Alarm.PV);]]>
</Text>
</Rung>
<Rung Number="18" Type="N">
<Comment>
<![CDATA[Map the analog input value to the analog alarm process variable if alarming is configured for the input.
Analog alarm array subscripts are equal to the analog input array subscripts.]]>
</Comment>
<Text>
<![CDATA[XIC(LI04Alarm.EnableCfg)MOV(LI04.CurrentValue,LI04Alarm.PV);]]>
</Text>
</Rung>
<Rung Number="19" Type="N">
<Comment>
<![CDATA[Set the out of range flag if raw value is outside the computed limits and turn on the alarm condition flag.]]>
</Comment>
<Text>
<![CDATA[LIM(LI03.RawHighLimit,LI03.RawValue,LI03.RawLowLimit)XIC(LI03.RealCfg)OTE(LI03.OutofRange);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Use="Reference" Name="Scale_Filtering">
</Routine>
<Routine Use="Reference" Name="Scale">
</Routine>
</Routines>
</Program>
</Programs>
</Controller>
