<Routines Use="Context">
<Routine Use="Target" Name="modPhaseTotal" Type="RLL">
<Description>
<![CDATA[Phase Totalizer Module]]>
</Description>
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[==========================================================================================================================================================
                                                                                                  mod Phase Total : Manage the phase totalizers (indexed routine from Total)

                                                    List of treatments handled by the routine :
                                                         - Verify if totalizer is enabled
                                                         - Reset of phase totalizer
                                                         - Analog input source
                                                         - Calculating the totalizer values
                                                    -----------------------------------------------------------------------------------------------------------------------------------------------------
                                                    History 
		2019-DEC-24 - Merck - Q. Spindler - Initial version for Candidate Release 1.00.00.00.a
==========================================================================================================================================================]]>
</Comment>
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[Verify if totalizer is enabled
==========================================================================================================================================================
Skip logic if Totalizer is not configured.]]>
</Comment>
<Text>
<![CDATA[XIO(PhaseTotalizer[Index].EnableCfg)RET();]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Comment>
<![CDATA[Reset of phase totalizer
==========================================================================================================================================================
Clear the phase totalizer if the reset flag is set or the reset all flag is set.]]>
</Comment>
<Text>
<![CDATA[[XIC(PhaseTotalizer[Index].PhaseReset) ,XIC(TimerControl.ResetAll) ][CLR(PhaseTotalizer[Index].Phase) ,OTU(PhaseTotalizer[Index].PhaseReset) ];]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Comment>
<![CDATA[Clear the step totalizer if the reset flag is set or the reset all flag is set.]]>
</Comment>
<Text>
<![CDATA[[XIC(PhaseTotalizer[Index].StepReset) ,XIC(TimerControl.ResetAll) ][CLR(PhaseTotalizer[Index].Step) ,OTU(PhaseTotalizer[Index].StepReset) ];]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Comment>
<![CDATA[Clear the pause totalizer if the reset flag is set or the reset all flag is set.]]>
</Comment>
<Text>
<![CDATA[[XIC(PhaseTotalizer[Index].PauseReset) ,XIC(TimerControl.ResetAll) ][CLR(PhaseTotalizer[Index].Pause) ,OTU(PhaseTotalizer[Index].PauseReset) ];]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Comment>
<![CDATA[Clear the user totalizer if the reset flag is set or the reset all flag is set.]]>
</Comment>
<Text>
<![CDATA[[XIC(PhaseTotalizer[Index].UserReset) ,XIC(TimerControl.ResetAll) ][CLR(PhaseTotalizer[Index].User) ,OTU(PhaseTotalizer[Index].UserReset) ];]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Comment>
<![CDATA[Clear the procedure totalizer if the reset procedure flag is set.]]>
</Comment>
<Text>
<![CDATA[XIC(TimerControl.ResetProcedure)CLR(PhaseTotalizer[Index].Procedure);]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Comment>
<![CDATA[Analog input source
==========================================================================================================================================================
Copy the AnalogInput source for totalizer PV based on the SourceCfg value. ]]>
</Comment>
<Text>
<![CDATA[[MOV(PhaseTotalizer[Index].SourceAddressCfg,AddressTotalizer) ,XIC(PhaseTotalizer[Index].SourceTypeCfg) MOV(MiscREAL[AddressTotalizer],PhaseTotalizer[Index].PV) ,XIO(PhaseTotalizer[Index].SourceTypeCfg) MOV(AnalogPoint[AddressTotalizer].CurrentValue,PhaseTotalizer[Index].PV) ];]]>
</Text>
</Rung>
<Rung Number="8" Type="N">
<Comment>
<![CDATA[Return if a second has not elapsed or the totalizer PV is less than the minumum.]]>
</Comment>
<Text>
<![CDATA[[XIO(TimerControl.Tick) ,LES(PhaseTotalizer[Index].PV,PhaseTotalizer[Index].PVmin) ]RET();]]>
</Text>
</Rung>
<Rung Number="9" Type="N">
<Comment>
<![CDATA[Calculating the totalizer values
==========================================================================================================================================================
Copy source to be totalized
Convert the process variable to units per second.]]>
</Comment>
<Text>
<![CDATA[DIV(PhaseTotalizer[Index].PV,PhaseTotalizer[Index].PVscale,PhaseTotalizer[Index].PVsec);]]>
</Text>
</Rung>
<Rung Number="10" Type="N">
<Comment>
<![CDATA[Phase totalizers.  Add the current PV scaled to units per second to the previous total.]]>
</Comment>
<Text>
<![CDATA[XIC(PhaseTotalizer[Index].PhaseEnable)ADD(PhaseTotalizer[Index].Phase,PhaseTotalizer[Index].PVsec,PhaseTotalizer[Index].Phase);]]>
</Text>
</Rung>
<Rung Number="11" Type="N">
<Comment>
<![CDATA[Step totalizers.  Add the current PV scaled to units per second to the previous total.]]>
</Comment>
<Text>
<![CDATA[XIC(PhaseTotalizer[Index].StepEnable)ADD(PhaseTotalizer[Index].Step,PhaseTotalizer[Index].PVsec,PhaseTotalizer[Index].Step);]]>
</Text>
</Rung>
<Rung Number="12" Type="N">
<Comment>
<![CDATA[Pause totalizers.  Add the current PV scaled to units per second to the previous total.]]>
</Comment>
<Text>
<![CDATA[XIC(PhaseTotalizer[Index].PauseEnable)ADD(PhaseTotalizer[Index].Pause,PhaseTotalizer[Index].PVsec,PhaseTotalizer[Index].Pause);]]>
</Text>
</Rung>
<Rung Number="13" Type="N">
<Comment>
<![CDATA[User totalizers.  Add the current PV scaled to units per second to the previous total.]]>
</Comment>
<Text>
<![CDATA[XIC(PhaseTotalizer[Index].UserEnable)ADD(PhaseTotalizer[Index].User,PhaseTotalizer[Index].PVsec,PhaseTotalizer[Index].User);]]>
</Text>
</Rung>
<Rung Number="14" Type="N">
<Comment>
<![CDATA[Procedure totalizers.  Add the current PV scaled to units per second to the previous total.]]>
</Comment>
<Text>
<![CDATA[XIC(PhaseTotalizer[Index].ProcedureEnable)ADD(PhaseTotalizer[Index].Procedure,PhaseTotalizer[Index].PVsec,PhaseTotalizer[Index].Procedure);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
</Routines>
</Program>
</Programs>
</Controller>
</RSLogix5000Content>
