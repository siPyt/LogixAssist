<Programs Use="Context">
<Program Use="Context" Name="MainProgram">
<Tags Use="Context">
<Tag Name="Index" TagType="Base" DataType="DINT" Radix="Decimal" Constant="false" ExternalAccess="Read/Write">
<Description>
<![CDATA[Index]]>
</Description>
<Data Format="L5K">
<![CDATA[2]]>
</Data>
<Data Format="Decorated">
<DataValue DataType="DINT" Radix="Decimal" Value="2"/>
</Data>
</Tag>
</Tags>
<Routines Use="Context">
<Routine Use="Target" Name="modTotal" Type="RLL">
<Description>
<![CDATA[Totalizer Module]]>
</Description>
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[==========================================================================================================================================================
                                                                                                  mod Total : Manage the global totalizers (indexed routine from Total)

                                                    List of treatments handled by the routine :
                                                         - Reset of totalizer
                                                         - Calculating the totalizer values
                                                    -----------------------------------------------------------------------------------------------------------------------------------------------------
                                                    History 
		2019-DEC-24 - Merck - Q. Spindler - Initial version for Candidate Release 1.00.00.00.a
==========================================================================================================================================================]]>
</Comment>
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[Reset of totalizer
==========================================================================================================================================================
Clear the totalizer if the reset flag is set or the reset all flag is set.]]>
</Comment>
<Text>
<![CDATA[[XIC(Totalizer[Index].Reset) ,XIC(TimerControl.ResetAll) ]ONS(Totalizer[Index].ResetONS)[MOV(Totalizer[Index].Total,Totalizer[Index].LastTotal) ,CLR(Totalizer[Index].Total) ];]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Comment>
<![CDATA[Clear reset bit after 3 seconds for event log to record.
]]>
</Comment>
<Text>
<![CDATA[XIC(Totalizer[Index].Reset)[TON(Totalizer[Index].ResetTimer,?,?) ,XIC(Totalizer[Index].ResetTimer.DN) OTU(Totalizer[Index].Reset) ];]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Comment>
<![CDATA[Return if a second has not elapsed or the totalizer PV is less than the minumum.]]>
</Comment>
<Text>
<![CDATA[[XIO(TimerControl.Tick) ,LES(Totalizer[Index].PV,Totalizer[Index].PVmin) ]RET();]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Comment>
<![CDATA[Calculating the totalizer values
==========================================================================================================================================================
Convert the process variable to units per second.]]>
</Comment>
<Text>
<![CDATA[DIV(Totalizer[Index].PV,Totalizer[Index].PVscale,Totalizer[Index].PVsec);]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Comment>
<![CDATA[Add the current PV scaled to units per second to the previous total.]]>
</Comment>
<Text>
<![CDATA[XIC(Totalizer[Index].Enable)ADD(Totalizer[Index].Total,Totalizer[Index].PVsec,Totalizer[Index].Total);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
</Routines>
</Program>
</Programs>
</Controller>
</RSLogix5000Content>
