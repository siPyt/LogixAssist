</Tags>
<Routines Use="Context">
<Routine Use="Target" Name="PCDateTime" Type="ST">
<STContent>
<Line Number="0">
<![CDATA[(* =======================================================================]]>
</Line>
<Line Number="1">
<![CDATA[	PCDateTime : Synchronize the PLC with PC clock]]>
</Line>
<Line Number="2">
<![CDATA[]]>
</Line>
<Line Number="3">
<![CDATA[	List of treatments]]>
</Line>
<Line Number="4">
<![CDATA[		- Synchronization]]>
</Line>
<Line Number="5">
<![CDATA[]]>
</Line>
<Line Number="6">
<![CDATA[-----------------------------------------------------------------------------------------------------------------------------------------------------]]>
</Line>
<Line Number="7">
<![CDATA[	History]]>
</Line>
<Line Number="8">
<![CDATA[		2019-DEC-24 - Merck - Q. Spindler - Initial version for Candidate Release 1.00.00.00.a]]>
</Line>
<Line Number="9">
<![CDATA[=========================================================================*)]]>
</Line>
<Line Number="10">
<![CDATA[]]>
</Line>
<Line Number="11">
<![CDATA[]]>
</Line>
<Line Number="12">
<![CDATA[(* Synchronization]]>
</Line>
<Line Number="13">
<![CDATA[=========================================================================*)]]>
</Line>
<Line Number="14">
<![CDATA[(*Update the internal PLC clock with the PC clock when the microseconds value is not -1*)]]>
</Line>
<Line Number="15">
<![CDATA[IF PCDateTime[6] <> -1 THEN;]]>
</Line>
<Line Number="16">
<![CDATA[	SSV (WALLCLOCKTIME, , DateTime, PCDateTime[0]);]]>
</Line>
<Line Number="17">
<![CDATA[	PCDateTime[6] := -1;]]>
</Line>
<Line Number="18">
<![CDATA[END_IF;]]>
</Line>
<Line Number="19">
<![CDATA[]]>
</Line>
<Line Number="20">
<![CDATA[(*Get PLC DST settings and set it to 0 of not already*)]]>
</Line>
<Line Number="21">
<![CDATA[GSV (WALLCLOCKTIME, ,ApplyDST , PLCDST);]]>
</Line>
<Line Number="22">
<![CDATA[IF PLCDST <> 0 THEN;]]>
</Line>
<Line Number="23">
<![CDATA[	PLCDST := 0;]]>
</Line>
<Line Number="24">
<![CDATA[	SSV (WALLCLOCKTIME, ,ApplyDST , PLCDST);]]>
</Line>
<Line Number="25">
<![CDATA[END_IF;]]>
</Line>
<Line Number="26">
<![CDATA[]]>
</Line>
<Line Number="27">
<![CDATA[(*Get PLC TimeZone and set it to UTC0 of not already*)]]>
</Line>
<Line Number="28">
<![CDATA[GSV (WALLCLOCKTIME, ,TimeZoneString, PLCTimeZoneString);]]>
</Line>
<Line Number="29">
<![CDATA[IF PLCTimeZoneString <> TimeZoneUTC0 THEN;]]>
</Line>
<Line Number="30">
<![CDATA[	SSV (WALLCLOCKTIME, ,TimeZoneString , TimeZoneUTC0);]]>
</Line>
<Line Number="31">
<![CDATA[END_IF;]]>
</Line>
<Line Number="32">
<![CDATA[]]>
</Line>
</STContent>
</Routine>
</Routines>
</Program>
</Programs>
</Controller>
</RSLogix5000Content>
