<Routines Use="Context">
<Routine Use="Target" Name="Scale_Filtering" Type="ST">
<STContent>
<Line Number="0">
<![CDATA[FeedBagVolume := WI001_Unfiltered / DENSITY;]]>
</Line>
<Line Number="1">
<![CDATA[FiltrateVolume101 := WI101_Unfiltered / DENSITY; //Millipore Weight Scale]]>
</Line>
<Line Number="2">
<![CDATA[FiltrateVolume102 := WI102_Unfiltered / DENSITY; //Customer Weight Scale]]>
</Line>
<Line Number="3">
<![CDATA[]]>
</Line>
<Line Number="4">
<![CDATA[]]>
</Line>
<Line Number="5">
<![CDATA[//CHECK THAT WE HAVE MET THE MINUMUM SAMPLE RATE]]>
</Line>
<Line Number="6">
<![CDATA[If TMR_SampleRate.ACC > Sample_Rate Then]]>
</Line>
<Line Number="7">
<![CDATA[]]>
</Line>
<Line Number="8">
<![CDATA[]]>
</Line>
<Line Number="9">
<![CDATA[		//CALCULATE THE MOVING AVERAGE OF THE FEEDBAG VOLUME]]>
</Line>
<Line Number="10">
<![CDATA[		FeedBagVolume_MAVE.In := FeedBagVolume;]]>
</Line>
<Line Number="11">
<![CDATA[		MAVE(FeedBagVolume_MAVE, FeedBagVolume_Array);]]>
</Line>
<Line Number="12">
<![CDATA[		LI001.CurrentValue := FeedBagVolume_MAVE.Out;]]>
</Line>
<Line Number="13">
<![CDATA[		WI001.CurrentValue := FeedBagVolume_MAVE.Out * DENSITY;]]>
</Line>
<Line Number="14">
<![CDATA[]]>
</Line>
<Line Number="15">
<![CDATA[//////////////////////  MOVING AVERAGE FILTERING  ////////////////////////////////////////////////////////////////////]]>
</Line>
<Line Number="16">
<![CDATA[]]>
</Line>
<Line Number="17">
<![CDATA[		//CALCULATE THE MOVING AVERAGE OF THE FILTRATE VOLUMES]]>
</Line>
<Line Number="18">
<![CDATA[		FiltraveVolume101_MAVE.In := FiltrateVolume101;]]>
</Line>
<Line Number="19">
<![CDATA[		MAVE(FiltraveVolume101_MAVE, FiltrateVolume101_Array);]]>
</Line>
<Line Number="20">
<![CDATA[		FiltrateVolume101_MaveFiltered := FiltraveVolume101_MAVE.Out;]]>
</Line>
<Line Number="21">
<![CDATA[		Weight101_MaveFiltered := FiltraveVolume101_MAVE.Out * DENSITY;]]>
</Line>
<Line Number="22">
<![CDATA[]]>
</Line>
<Line Number="23">
<![CDATA[		//CALCULATE THE MOVING AVERAGE OF THE FILTRATE VOLUMES]]>
</Line>
<Line Number="24">
<![CDATA[		FiltraveVolume102_MAVE.In := FiltrateVolume102;]]>
</Line>
<Line Number="25">
<![CDATA[		MAVE(FiltraveVolume102_MAVE, FiltrateVolume102_Array);]]>
</Line>
<Line Number="26">
<![CDATA[		FiltrateVolume102_MaveFiltered := FiltraveVolume102_MAVE.Out;]]>
</Line>
<Line Number="27">
<![CDATA[		Weight102_MaveFiltered := FiltraveVolume102_MAVE.Out * DENSITY;]]>
</Line>
<Line Number="28">
<![CDATA[]]>
</Line>
<Line Number="29">
<![CDATA[		//Calculate the flow based on the current configuration]]>
</Line>
<Line Number="30">
<![CDATA[		If Configuration.Option[2] = 1 Then;]]>
</Line>
<Line Number="31">
<![CDATA[			FiltrateVolume_MaveFiltered := FiltrateVolume101_MaveFiltered;]]>
</Line>
<Line Number="32">
<![CDATA[		ElsIf Configuration.Option[2] = 2 Then;]]>
</Line>
<Line Number="33">
<![CDATA[			FiltrateVolume_MaveFiltered := FiltrateVolume102_MaveFiltered;]]>
</Line>
<Line Number="34">
<![CDATA[		End_If;]]>
</Line>
<Line Number="35">
<![CDATA[	]]>
</Line>
<Line Number="36">
<![CDATA[		If PU01.RunStatus AND (Configuration.Option[4] <> 2 OR Configuration.Option[4] <> 2) Then]]>
</Line>
<Line Number="37">
<![CDATA[			If (TMR_MaveFlow.ACC > Flow_Sample_Rate) Then]]>
</Line>
<Line Number="38">
<![CDATA[				If (ABS(FiltrateVolume_MaveFiltered - FiltrateVolume_MaveFiltered_Prev) >= 0.01) Then]]>
</Line>
<Line Number="39">
<![CDATA[					//CALCULATE THE FILTRATE FLOW RATE]]>
</Line>
<Line Number="40">
<![CDATA[					//Filtrate Flow Rate = ((Current Volume - Previous Volume) / Time Elapsed (in s)) * 60]]>
</Line>
<Line Number="41">
<![CDATA[					FiltrateFlow := ((FiltrateVolume_MaveFiltered - FiltrateVolume_MaveFiltered_Prev) / (TMR_MaveFlow.ACC / 1000))*60;]]>
</Line>
<Line Number="42">
<![CDATA[					FiltrateVolume_MaveFiltered_Prev := FiltrateVolume_MaveFiltered;]]>
</Line>
<Line Number="43">
<![CDATA[]]>
</Line>
<Line Number="44">
<![CDATA[					//CALCULATE THE MOVING AVERAGE OF THE FILTRATE FLOW RATE]]>
</Line>
<Line Number="45">
<![CDATA[					FiltrateFlow_MAVE.In := FiltrateFlow;]]>
</Line>
<Line Number="46">
<![CDATA[					MAVE(FiltrateFlow_MAVE, FiltrateFlow_Array);]]>
</Line>
<Line Number="47">
<![CDATA[					Flow_MaveFiltered := FiltrateFlow_MAVE.Out;]]>
</Line>
<Line Number="48">
<![CDATA[]]>
</Line>
<Line Number="49">
<![CDATA[					TMR_MaveFlow.ACC :=0;]]>
</Line>
<Line Number="50">
<![CDATA[				End_If;				]]>
</Line>
<Line Number="51">
<![CDATA[			End_If;]]>
</Line>
<Line Number="52">
<![CDATA[		Else]]>
</Line>
<Line Number="53">
<![CDATA[			Flow_MaveFiltered := 0;]]>
</Line>
<Line Number="54">
<![CDATA[			TMR_MaveFlow.ACC :=0;]]>
</Line>
<Line Number="55">
<![CDATA[		End_If;]]>
</Line>
<Line Number="56">
<![CDATA[]]>
</Line>
<Line Number="57">
<![CDATA[///////////////////////  EXPONENTIAL FILTERING  ///////////////////////////////////////////////////////////////////////////////]]>
</Line>
<Line Number="58">
<![CDATA[]]>
</Line>
<Line Number="59">
<![CDATA[	FiltrateVolume101_ExpFiltered := (ExpConst_Vol * FiltrateVolume101_ExpFiltered) + ((1-ExpConst_Vol)*FiltrateVolume101);]]>
</Line>
<Line Number="60">
<![CDATA[	FiltrateVolume102_ExpFiltered := (ExpConst_Vol * FiltrateVolume102_ExpFiltered) + ((1-ExpConst_Vol)*FiltrateVolume102);]]>
</Line>
<Line Number="61">
<![CDATA[]]>
</Line>
<Line Number="62">
<![CDATA[	//Calculate the flow based on the current configuration]]>
</Line>
<Line Number="63">
<![CDATA[	If Configuration.Option[2] = 1 Then;]]>
</Line>
<Line Number="64">
<![CDATA[		FiltrateVolume_ExpFiltered := FiltrateVolume101_ExpFiltered;]]>
</Line>
<Line Number="65">
<![CDATA[	ElsIf Configuration.Option[2] = 2 Then;]]>
</Line>
<Line Number="66">
<![CDATA[		FiltrateVolume_ExpFiltered := FiltrateVolume102_ExpFiltered;]]>
</Line>
<Line Number="67">
<![CDATA[	End_If;]]>
</Line>
<Line Number="68">
<![CDATA[]]>
</Line>
<Line Number="69">
<![CDATA[	If TMR_EXPFlow.ACC > FlowEXP_SampleRate Then]]>
</Line>
<Line Number="70">
<![CDATA[		FiltrateFlow := ((FiltrateVolume_ExpFiltered - FiltrateVolume_ExpFiltered_Prev) / (TMR_EXPFlow.ACC / 1000))*60;]]>
</Line>
<Line Number="71">
<![CDATA[		FiltrateVolume_ExpFiltered_Prev := FiltrateVolume_ExpFiltered;]]>
</Line>
<Line Number="72">
<![CDATA[]]>
</Line>
<Line Number="73">
<![CDATA[		Flow_ExpFiltered := (ExpConst_Flow * Flow_ExpFiltered) + ((1-ExpConst_Flow)*FiltrateFlow);]]>
</Line>
<Line Number="74">
<![CDATA[		TMR_EXPFlow.ACC := 0;]]>
</Line>
<Line Number="75">
<![CDATA[	End_If;]]>
</Line>
<Line Number="76">
<![CDATA[]]>
</Line>
<Line Number="77">
<![CDATA[		Weight101_ExpFiltered := FiltrateVolume101_ExpFiltered * DENSITY;]]>
</Line>
<Line Number="78">
<![CDATA[		Weight102_ExpFiltered := FiltrateVolume102_ExpFiltered * DENSITY;]]>
</Line>
<Line Number="79">
<![CDATA[]]>
</Line>
<Line Number="80">
<![CDATA[//////////////////////  MOVE VALUES TO SPECIFIED INPUTS ////////////////////////////////////////////////////////////////////////////////]]>
</Line>
<Line Number="81">
<![CDATA[	]]>
</Line>
<Line Number="82">
<![CDATA[	If PU01.RunStatus AND (NOT FI101.RealCfg) Then //Populate Analog Inputs when Pump is running and FI101 is calculated value]]>
</Line>
<Line Number="83">
<![CDATA[		If CurrentFilter = 0 Then //No Filtering]]>
</Line>
<Line Number="84">
<![CDATA[			WI101.CurrentValue := FiltrateVolume101 * DENSITY;]]>
</Line>
<Line Number="85">
<![CDATA[			WI102.CurrentValue := FiltrateVolume102 * DENSITY;]]>
</Line>
<Line Number="86">
<![CDATA[			FI101.CurrentValue := ((FiltrateVolume101 - FiltrateVolume101_Prev) / (TMR_SampleRate.ACC / 1000))*60;]]>
</Line>
<Line Number="87">
<![CDATA[			FiltrateVolume101_Prev := FiltrateVolume101;]]>
</Line>
<Line Number="88">
<![CDATA[		End_If;]]>
</Line>
<Line Number="89">
<![CDATA[]]>
</Line>
<Line Number="90">
<![CDATA[		If CurrentFilter = 1 Then //Moving Average Filter Active]]>
</Line>
<Line Number="91">
<![CDATA[			WI101.CurrentValue := Weight101_MaveFiltered;]]>
</Line>
<Line Number="92">
<![CDATA[			WI102.CurrentValue := Weight102_MaveFiltered;]]>
</Line>
<Line Number="93">
<![CDATA[			FI101.CurrentValue := Flow_MaveFiltered;]]>
</Line>
<Line Number="94">
<![CDATA[		End_If;]]>
</Line>
<Line Number="95">
<![CDATA[]]>
</Line>
<Line Number="96">
<![CDATA[		If CurrentFilter = 2 Then //Exponential Linear Recursive Filter active]]>
</Line>
<Line Number="97">
<![CDATA[			WI101.CurrentValue := Weight101_ExpFiltered;]]>
</Line>
<Line Number="98">
<![CDATA[			WI102.CurrentValue := Weight102_ExpFiltered;]]>
</Line>
<Line Number="99">
<![CDATA[			FI101.CurrentValue := Flow_ExpFiltered;]]>
</Line>
<Line Number="100">
<![CDATA[		End_If;]]>
</Line>
<Line Number="101">
<![CDATA[]]>
</Line>
<Line Number="102">
<![CDATA[	Else //On]]>
</Line>
<Line Number="103">
<![CDATA[]]>
</Line>
<Line Number="104">
<![CDATA[		If NOT FI101.RealCfg Then // Only populate with 0.00 when FI101 is a calculated value and the Feed Pump is OFF]]>
</Line>
<Line Number="105">
<![CDATA[			FI101.CurrentValue := 0.00;]]>
</Line>
<Line Number="106">
<![CDATA[		End_If;]]>
</Line>
<Line Number="107">
<![CDATA[]]>
</Line>
<Line Number="108">
<![CDATA[		If CurrentFilter = 0 Then //No Filtering]]>
</Line>
<Line Number="109">
<![CDATA[			WI101.CurrentValue := FiltrateVolume101 * DENSITY;]]>
</Line>
<Line Number="110">
<![CDATA[			WI102.CurrentValue := FiltrateVolume102 * DENSITY;]]>
</Line>
<Line Number="111">
<![CDATA[		End_If;]]>
</Line>
<Line Number="112">
<![CDATA[]]>
</Line>
<Line Number="113">
<![CDATA[		If CurrentFilter = 1 Then //Moving Average Filter Active]]>
</Line>
<Line Number="114">
<![CDATA[			WI101.CurrentValue := Weight101_MaveFiltered;]]>
</Line>
<Line Number="115">
<![CDATA[			WI102.CurrentValue := Weight102_MaveFiltered;]]>
</Line>
<Line Number="116">
<![CDATA[		End_If;]]>
</Line>
<Line Number="117">
<![CDATA[]]>
</Line>
<Line Number="118">
<![CDATA[		If CurrentFilter = 2 Then //Exponential Linear Recursive Filter active]]>
</Line>
<Line Number="119">
<![CDATA[			WI101.CurrentValue := Weight101_ExpFiltered;]]>
</Line>
<Line Number="120">
<![CDATA[			WI102.CurrentValue := Weight102_ExpFiltered;]]>
</Line>
<Line Number="121">
<![CDATA[		End_If;]]>
</Line>
<Line Number="122">
<![CDATA[	End_If;]]>
</Line>
<Line Number="123">
<![CDATA[]]>
</Line>
<Line Number="124">
<![CDATA[	TMR_SampleRate.ACC := 0;]]>
</Line>
<Line Number="125">
<![CDATA[End_If;]]>
</Line>
</STContent>
</Routine>
</Routines>
</Program>
</Programs>
</Controller>
</RSLogix5000Content>
