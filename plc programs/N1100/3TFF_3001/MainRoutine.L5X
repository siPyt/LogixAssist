<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[PC Date and Time Synchronization]]>
</Comment>
<Text>
<![CDATA[JSR(PCDateTime,0);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[EQU(ThisSystem.Value,1)XIC(PID07.LoopCfg)JSR(PID07_Gradiant,0);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Text>
<![CDATA[EQU(ThisSystem.Value,1)XIC(PID03.LoopCfg)[OTE(PID13.Enable) ,JSR(PCV032,0) ];]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Text>
<![CDATA[EQU(ThisSystem.Value,2)JSR(Output_Digital_highSpeed,0);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Text>
<![CDATA[EQU(ThisSystem.Value,2)[OTE(PID14.Enable) ,JSR(PCV001,0) ];]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Text>
<![CDATA[EQU(ThisSystem.Value,2)[OTE(PID15.Enable) ,JSR(PCV101,0) ];]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Text>
<![CDATA[EQU(ThisSystem.Value,2)JSR(Input_Analog_HighSpeed,0);]]>
</Text>
</Rung>
