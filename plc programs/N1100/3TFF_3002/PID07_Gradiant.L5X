<Rung Number="6" Type="N">
<Text>
<![CDATA[XIC(PID07.Auto2)ONS(PID07.Auto2OSR)[OTU(PID07.Manual) ,OTU(PID07.Auto1) ,OTU(PID07.Auto3) ,OTU(PID07.Auto4) ];]]>
