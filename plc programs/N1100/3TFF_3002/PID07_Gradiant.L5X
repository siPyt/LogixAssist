<Rung Number="0" Type="N">
<Text>
<![CDATA[[[[XIO(XV001.Control) XIO(XV002.Control) XIO(XV003.Control) XIO(XV004.Control) ,[XIC(XV001.Control) ,[XIC(XV002.Control) ,[XIC(XV003.Control) ,XIC(XV004.Control) ] ] ] XIO(XV005.Control) ] XIO(HV06.Control) ,XIO(HV07.Control) XIO(HV08.Control) XIO(XV009.Control) XIO(HV10.Control) XIO(HV11.Control) ] ,[XIO(P001.RunStatus) ,XIC(PID11.On) XIO(P002.RunStatus) ] ]XIC(PID07.On)OTE(PID07.Interlock);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[XIC(PID07.On)XIO(PID07.Interlock)OTE(PID07.Enable);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Text>
<![CDATA[[[[XIC(PID07.Manual) ,XIC(PID07.Auto1) ] MOV(PID07.Auto1PVCfg,Address) ,XIC(PID07.Auto2) MOV(PID07.Auto2PVCfg,Address) ] ,XIC(PID07.Auto3) MOV(PID07.Auto3PVCfg,Address) ];]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Text>
<![CDATA[[MOV(AnalogPoint[Address].CurrentValue,PID07.PV) ,MOV(AnalogPoint[Address].ScaledMax,PID07.PID.MAXI) ,MOV(AnalogPoint[Address].ScaledMax,PID07.PID.MAXS) ];]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Text>
<![CDATA[XIC(PID07.Manual)ONS(PID07.ManualOSR)[OTU(PID07.Auto1) ,OTU(PID07.Auto2) ,OTU(PID07.Auto3) ,OTU(PID07.Auto4) ,XIC(PID07.Enable) [MOV(PID07.CV,PID07.SPManual) ,MOV(PID07.CV,PID07.SPManualSave) ] ];]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Text>
<![CDATA[XIC(PID07.Auto1)ONS(PID07.Auto1OSR)[OTU(PID07.Manual) ,OTU(PID07.Auto2) ,OTU(PID07.Auto3) ,OTU(PID07.Auto4) ];]]>
