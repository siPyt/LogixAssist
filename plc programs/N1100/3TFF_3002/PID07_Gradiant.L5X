<Rung Number="8" Type="N">
<Text>
<![CDATA[XIC(PID07.Auto4)ONS(PID07.Auto4OSR)[OTU(PID07.Manual) ,OTU(PID07.Auto1) ,OTU(PID07.Auto2) ,OTU(PID07.Auto3) ];]]>
