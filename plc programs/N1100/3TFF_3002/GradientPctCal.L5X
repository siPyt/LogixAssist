<Programs Use="Context">
<Program Use="Context" Name="MainProgram">
<Tags Use="Context">
<Tag Name="Segment" TagType="Base" DataType="DINT" Radix="Decimal" Constant="false" ExternalAccess="Read/Write">
<Data>01 00 00 00</Data>
<Data Format="Decorated">
<DataValue DataType="DINT" Radix="Decimal" Value="1"/>
</Data>
</Tag>
<Tag Name="M" TagType="Base" DataType="REAL" Radix="Float" Constant="false" ExternalAccess="Read/Write">
<Data>90 0B A3 3F</Data>
<Data Format="Decorated">
<DataValue DataType="REAL" Radix="Float" Value="1.2737904"/>
</Data>
</Tag>
<Tag Name="Y2" TagType="Base" DataType="REAL" Radix="Float" Constant="false" ExternalAccess="Read/Write">
<Data>46 42 C9 42</Data>
<Data Format="Decorated">
<DataValue DataType="REAL" Radix="Float" Value="100.62944"/>
</Data>
</Tag>
<Tag Name="X2" TagType="Base" DataType="REAL" Radix="Float" Constant="false" ExternalAccess="Read/Write">
<Data>00 00 A0 42</Data>
<Data Format="Decorated">
<DataValue DataType="REAL" Radix="Float" Value="80.0"/>
</Data>
</Tag>
<Tag Name="X1" TagType="Base" DataType="REAL" Radix="Float" Constant="false" ExternalAccess="Read/Write">
<Data>00 00 80 3F</Data>
<Data Format="Decorated">
<DataValue DataType="REAL" Radix="Float" Value="1.0"/>
</Data>
</Tag>
<Tag Name="Y1" TagType="Base" DataType="REAL" Radix="Float" Constant="false" ExternalAccess="Read/Write">
<Data>00 00 00 00</Data>
<Data Format="Decorated">
<DataValue DataType="REAL" Radix="Float" Value="0.0"/>
</Data>
</Tag>
</Tags>
<Routines Use="Context">
<Routine Use="Target" Name="GradientPctCal" Type="ST">
<Description>
<![CDATA[Gradient Percentage Calibration Module]]>
</Description>
<STContent>
<Line Number="0">
<![CDATA[(*Gradient Percentage Calibration*)]]>
</Line>
<Line Number="1">
<![CDATA[GradientPctCal.Input := ControlLoop[7].CV; (*Set the input value to the gradient percentage set point*)]]>
</Line>
<Line Number="2">
<![CDATA[Segment := 1; (*Initialize the segment*)]]>
</Line>
<Line Number="3">
<![CDATA[]]>
</Line>
<Line Number="4">
<![CDATA[(*Loop through the Y values to locate the lookup table segment where the value falls*)]]>
</Line>
<Line Number="5">
<![CDATA[WHILE GradientPctCal.Input > GradientPctCal.Y[Segment] DO;]]>
</Line>
<Line Number="6">
<![CDATA[	IF Segment = GradientPctCal.Segments OR Segment = 20 THEN;]]>
</Line>
<Line Number="7">
<![CDATA[		EXIT; (*Done if max segments reached*)]]>
</Line>
<Line Number="8">
<![CDATA[	END_IF;]]>
</Line>
<Line Number="9">
<![CDATA[	Segment := Segment + 1;]]>
</Line>
<Line Number="10">
<![CDATA[END_WHILE;]]>
</Line>
<Line Number="11">
<![CDATA[]]>
</Line>
<Line Number="12">
<![CDATA[(*Get the X and Y values at the start and end of the segment*)]]>
</Line>
<Line Number="13">
<![CDATA[Y1 := GradientPctCal.Y[Segment - 1];]]>
</Line>
<Line Number="14">
<![CDATA[Y2 := GradientPctCal.Y[Segment];]]>
</Line>
<Line Number="15">
<![CDATA[X1 := GradientPctCal.X[Segment - 1];]]>
</Line>
<Line Number="16">
<![CDATA[X2 := GradientPctCal.X[Segment];]]>
</Line>
<Line Number="17">
<![CDATA[]]>
</Line>
<Line Number="18">
<![CDATA[IF (X2 - X1) <> 0 THEN; (*Compute result only if slope is not infinite*)]]>
</Line>
<Line Number="19">
<![CDATA[	M := (Y2 - Y1) / (X2 - X1); (* Compute the slope of the segment*)]]>
</Line>
<Line Number="20">
<![CDATA[	GradientPctCal.Result := (GradientPctCal.Input - Y1) / M + X1; (*Interpolate the result from X = (Y - B) / M + X1*)]]>
</Line>
<Line Number="21">
<![CDATA[	ControlLoop[7].CV := GradientPctCal.Result; (*Set the gradient percentage value equal to the result*)]]>
</Line>
<Line Number="22">
<![CDATA[END_IF;]]>
</Line>
<Line Number="23">
<![CDATA[]]>
</Line>
<Line Number="24">
<![CDATA[(* Set State *)]]>
</Line>
<Line Number="25">
<![CDATA[If GradientPctCal.Enable and GradientPctCal.FeedForward THEN; GradientPctCal.State := 2; END_IF;]]>
</Line>
<Line Number="26">
<![CDATA[If GradientPctCal.Enable and Not (GradientPctCal.FeedForward) THEN; GradientPctCal.State := 1; END_IF;]]>
</Line>
<Line Number="27">
<![CDATA[If Not(GradientPctCal.Enable) THEN; GradientPctCal.State := 0; END_IF;]]>
</Line>
<Line Number="28">
<![CDATA[]]>
</Line>
<Line Number="29">
<![CDATA[]]>
</Line>
</STContent>
</Routine>
</Routines>
</Program>
</Programs>
</Controller>
</RSLogix5000Content>
